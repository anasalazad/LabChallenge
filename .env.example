# Labs 1-4: copy this file to ".env" (same folder) and put your own keys in it.
# .env is in .gitignore, so it never goes to GitHub. Never paste keys into code or screenshots.

# Lab 1, 3, 4 - Google AI Studio: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key

# Lab 2 - Hugging Face: huggingface.co -> Settings -> Access Tokens
HF_TOKEN=hf_your_token

# Lab 3 - Pinecone console -> API Keys, and the name of the index you created (dense, 1024, cosine)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_index_name
