# Copy this file to ".env" (in this folder OR the top folder of the repo) and fill in your own keys.
# .env is in .gitignore - never commit it, paste keys into code, or show them in a screenshot.
GEMINI_API_KEY=your_gemini_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_index_name
